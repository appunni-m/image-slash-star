+           hdr->render_width, hdr->render_height, hdr->refresh_frame_flags);
+}
+
+static void sequence_trace_frame_header(const Dav1dContext *const c,
+                                        const Dav1dData *const in,
+                                        const int obu_type)
+{
+    const Dav1dFrameHeader *const hdr = c->frame_hdr;
+    const unsigned index = sequence_trace_header_index++;
+    sequence_trace_last_header_index = index;
+    printf("@LIFECYCLE {\"event\":\"frame_header\","
+           "\"header_index\":%u,\"obu_type\":%d,\"pts\":%" PRId64 ","
+           "\"frame_type\":%d,\"frame_offset\":%u,\"frame_id\":%u,"
+           "\"show_existing_frame\":%u,\"existing_frame_idx\":%u,"
+           "\"show_frame\":%u,\"showable_frame\":%u,"
+           "\"error_resilient_mode\":%u,\"refresh_frame_flags\":%u,"
+           "\"width\":%d,\"height\":%d,\"render_width\":%d,"
+           "\"render_height\":%d,\"references_before\":[",
+           index, obu_type, in->m.timestamp, hdr->frame_type,
+           hdr->frame_offset, hdr->frame_id, hdr->show_existing_frame,
+           hdr->show_existing_frame ? hdr->existing_frame_idx : 0,
+           hdr->show_frame, hdr->showable_frame, hdr->error_resilient_mode,
+           hdr->refresh_frame_flags, hdr->width[1], hdr->height,
+           hdr->render_width, hdr->render_height);
+    for (int slot = 0; slot < 8; slot++) {
+        if (slot) putchar(',');
+        sequence_trace_reference(c, slot);
+    }
+    puts("]}");
+}
