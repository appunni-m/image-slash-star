+static void sequence_trace_reference(const Dav1dContext *const c, const int slot)
+{
+    const Dav1dFrameHeader *const hdr = c->refs[slot].p.p.frame_hdr;
+    if (!hdr) {
+        fputs("null", stdout);
+        return;
+    }
+    printf("{\"slot\":%d,\"frame_type\":%d,\"frame_offset\":%u,"
+           "\"frame_id\":%u,\"show_frame\":%u,\"showable_frame\":%u,"
