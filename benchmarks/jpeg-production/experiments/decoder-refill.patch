@@ -262,0 +268,26 @@ impl<'a> FastBitReader<'a> {
+    #[inline(always)]
+    fn append_unstuffed_bytes(&mut self, byte_count: usize) -> bool {
+        let (padding, bit_count) = match byte_count {
+            6 => (2, 48),
+            7 => (1, 56),
+            _ => return false,
+        };
+        // The reader range is bounded by the input; compare remaining bytes
+        // before adding so the end offset cannot overflow.
+        if byte_count > self.end.saturating_sub(self.pos) {
+            return false;
+        }
+        let end = self.pos.saturating_add(byte_count);
+        let bytes = &self.data[self.pos..end];
+        if bytes.contains(&0xFF) {
+            return false;
+        }
+
+        let mut padded = [0_u8; 8];
+        padded[padding..].copy_from_slice(bytes);
+        self.buf = self.buf.wrapping_shl(bit_count) | u64::from_be_bytes(padded);
+        self.pos = end;
+        self.bits = self.bits.wrapping_add(bit_count);
+        true
+    }
