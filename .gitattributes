* text=auto eol=lf

*.bin binary
*.bmp binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.tif binary
*.tiff binary
*.webp binary

tests/fixtures/outputs/** linguist-generated=true

# Unified diff context lines retain a marker even when their source line is empty.
scripts/coverage-exporter/real-over-unused-v3.patch whitespace=-blank-at-eol

# Unified native-oracle patches preserve mandatory empty context markers.
scripts/avif_fixture_oracle/*.patch whitespace=-blank-at-eol
# This hunk ends with an empty context line, which must remain in the patch.
scripts/avif_fixture_oracle/libaom-mixed-key-segmentation.patch whitespace=-blank-at-eol,-blank-at-eof
